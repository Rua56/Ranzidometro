{
  "id": "/",
  "name": "Ranzidometro",
  "short_name": "Ranzidometro",
  "description": "Il check-in quotidiano dell'umore: quanto sei up, quanto sei down e quanto pepe hai in corpo.",
  "lang": "it",
  "start_url": "/?src=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#eef3f4",
  "theme_color": "#eef3f4",
  "categories": [
    "lifestyle",
    "health"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Check-in veloce",
      "short_name": "Check-in",
      "description": "Rispondi alle domande di oggi",
      "url": "/?azione=checkin",
      "icons": [
        {
          "src": "/icons/sc-checkin.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Manda una coccola",
      "short_name": "Coccola",
      "description": "Manda un abbraccio al partner",
      "url": "/?azione=coccola",
      "icons": [
        {
          "src": "/icons/sc-coccola.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}