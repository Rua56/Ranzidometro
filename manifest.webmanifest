{
  "id": "/",
  "name": "Ranzidometro",
  "short_name": "Ranzidometro",
  "description": "Il check-in quotidiano dell'umore: rispondi a qualche domanda e Ranzi ti dice quanto sei up, quanto sei down e quanto pepe hai in corpo. Con modalità coppia, sticker e verdetto di fine mese.",
  "lang": "it",
  "dir": "ltr",
  "start_url": "/?src=app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#eef3f4",
  "theme_color": "#eef3f4",
  "categories": [
    "lifestyle",
    "health"
  ],
  "prefer_related_applications": false,
